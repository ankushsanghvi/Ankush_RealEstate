# Optional. Without a key the pipeline runs in deterministic "rules" mode.
ANTHROPIC_API_KEY=
# Leave empty for api.anthropic.com, or point at an Anthropic-compatible gateway (Messages API).
ANTHROPIC_BASE_URL=
# Model ids as the provider names them. Recommended (fast, cheap, reliable JSON): Haiku 4.5 for every step,
# Sonnet 4.6 as the fallback. Any Claude model works, e.g. claude-opus-5-5 / claude-sonnet-5-5 on api.anthropic.com.
LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK_MODEL=claude-sonnet-4-6
# Optional cheaper model for latency-sensitive steps (classification).
LLM_FAST_MODEL=claude-haiku-4-5
# auto | native | json — auto tries native structured outputs and falls back to JSON-by-instruction if the provider strips them.
LLM_STRUCTURED_OUTPUT=auto
# messages (Anthropic SDK; api.anthropic.com or Anthropic-compatible gateway) | chat (OpenAI-style /v1/chat/completions on a gateway)
LLM_API_FORMAT=messages
LLM_TIMEOUT_S=25
LLM_ENABLED=true

# fastembed (neural, default) | lsa (pure scikit-learn fallback)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
